<span class="estado-badge @ClaseEstado">
    @Texto
</span>

@code {
    [Parameter, EditorRequired]
    public EstadoTurno Estado { get; set; }

    private string Texto =>
        Estado switch
        {
            EstadoTurno.Pendiente => "Pendiente",
            EstadoTurno.Confirmado => "Confirmado",
            EstadoTurno.Completado => "Completado",
            EstadoTurno.Cancelado => "Cancelado",
            _ => Estado.ToString()
        };

    private string ClaseEstado =>
        Estado switch
        {
            EstadoTurno.Pendiente => "estado-pendiente",
            EstadoTurno.Confirmado => "estado-confirmado",
            EstadoTurno.Completado => "estado-completado",
            EstadoTurno.Cancelado => "estado-cancelado",
            _ => "estado-neutro"
        };
}
