@inject IJSRuntime JS
@implements IAsyncDisposable

<article class="turno-card">
    <header class="turno-header">
        <div>
            <span class="turno-fecha">
                @Turno.FechaHora.ToString("dd/MM/yyyy HH:mm")
            </span>

            <h3>@Turno.ClienteNombre</h3>
        </div>

        <EstadoTurnoBadge Estado="Turno.Estado" />
    </header>

    <dl class="turno-grid">
        <div>
            <dt>Teléfono</dt>
            <dd>@Turno.ClienteTelefono</dd>
        </div>

        <div>
            <dt>Vehículo</dt>
            <dd>@Turno.AutoMarca @Turno.AutoModelo</dd>
        </div>

        <div>
            <dt>Servicio</dt>
            <dd>@Turno.ServicioNombre</dd>
        </div>

        <div>
            <dt>Duración</dt>
            <dd>@Turno.ServicioDuracionMinutos min</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Turno.Observaciones))
    {
        <p class="observaciones">
            <strong>Observaciones:</strong>
            @Turno.Observaciones
        </p>
    }

    @if (OnCambiarEstado.HasDelegate)
    {
        <footer class="turno-actions">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    title="Copiar teléfono"
                    @onclick="CopiarTelefonoAsync">
                Copiar teléfono
            </button>

            @if (Turno.Estado is EstadoTurno.Pendiente
                or EstadoTurno.Confirmado)
            {
                @if (Turno.Estado == EstadoTurno.Pendiente)
                {
                    <button class="btn btn-sm btn-primary"
                            @onclick="() => CambiarAsync(EstadoTurno.Confirmado)">
                        Confirmar
                    </button>
                }

                @if (Turno.Estado == EstadoTurno.Confirmado)
                {
                    <button class="btn btn-sm btn-success"
                            @onclick="() => CambiarAsync(EstadoTurno.Completado)">
                        Completar
                    </button>
                }

                <button class="btn btn-sm btn-outline-danger"
                        @onclick="() => CambiarAsync(EstadoTurno.Cancelado)">
                    Cancelar
                </button>
            }
        </footer>

        @if (!string.IsNullOrWhiteSpace(_mensajeInterop))
        {
            <small class="interop-status"
                   role="status">
                @_mensajeInterop
            </small>
        }
    }
</article>

@code {
    [Parameter, EditorRequired]
    public TurnoDto Turno { get; set; } = default!;

    [Parameter]
    public EventCallback<EstadoTurno> OnCambiarEstado { get; set; }

    private IJSObjectReference? _modulo;
    private string? _mensajeInterop;

    private Task CambiarAsync(EstadoTurno estado) =>
        OnCambiarEstado.InvokeAsync(estado);

    private async Task CopiarTelefonoAsync()
    {
        _mensajeInterop = null;

        try
        {
            _modulo ??=
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/lavaderoInterop.js?v=20261102-2");

            await _modulo.InvokeVoidAsync(
                "copiarAlPortapapeles",
                Turno.ClienteTelefono);

            _mensajeInterop = "Teléfono copiado.";
        }
        catch
        {
            _mensajeInterop =
                "No se pudo copiar el teléfono.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_modulo is not null)
        {
            try
            {
                await _modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito Blazor ya se cerró.
            }
        }
    }
}
