@if (TotalPaginas > 1)
{
    <nav class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4" aria-label="Paginación">
        <span class="text-secondary small">Página @PaginaActual de @TotalPaginas</span>
        <div class="btn-group" role="group" aria-label="Cambiar página">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(PaginaActual <= 1)"
                    @onclick="AnteriorAsync">
                Anterior
            </button>
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(PaginaActual >= TotalPaginas)"
                    @onclick="SiguienteAsync">
                Siguiente
            </button>
        </div>
    </nav>
}

@code {
    [Parameter]
    public int PaginaActual { get; set; } = 1;

    [Parameter]
    public int TotalPaginas { get; set; }

    [Parameter]
    public EventCallback<int> OnCambio { get; set; }

    private Task AnteriorAsync() =>
        PaginaActual > 1 ? OnCambio.InvokeAsync(PaginaActual - 1) : Task.CompletedTask;

    private Task SiguienteAsync() =>
        PaginaActual < TotalPaginas ? OnCambio.InvokeAsync(PaginaActual + 1) : Task.CompletedTask;
}
