@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Ingresar | Lavadero</PageTitle>

<section class="login-shell" aria-labelledby="titulo-login">
    <article class="login-card">
        <header class="mb-4">
            <span class="eyebrow">Área administrativa</span>
            <h1 id="titulo-login">Ingresar</h1>
            <p class="text-secondary mb-0">
                Acceso exclusivo para el dueño o administrador del lavadero.
            </p>
        </header>

        @if (Error == "credenciales")
        {
            <AlertMessage Mensaje="Usuario o contraseña incorrectos."
                          Tipo="danger" />
        }
        else if (Error == "bloqueado")
        {
            <AlertMessage Mensaje="El usuario está temporalmente bloqueado por varios intentos fallidos."
                          Tipo="warning" />
        }

        <form method="post" action="/account/login">
            <AntiforgeryToken />

            <input type="hidden"
                   name="returnUrl"
                   value="@ReturnUrl" />

            <div class="mb-3">
                <label class="form-label"
                       for="usuario">
                    Usuario
                </label>

                <input id="usuario"
                       name="usuario"
                       class="form-control"
                       autocomplete="username"
                       maxlength="100"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label"
                       for="password">
                    Contraseña
                </label>

                <input id="password"
                       name="password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       required />
            </div>

            <div class="form-check mb-4">
                <input id="recordarme"
                       name="recordarme"
                       value="true"
                       type="checkbox"
                       class="form-check-input" />

                <label class="form-check-label"
                       for="recordarme">
                    Mantener sesión iniciada
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Ingresar
            </button>
        </form>

        <footer class="mt-4 text-center">
            <a href="/" class="small">
                Volver al sitio público
            </a>
        </footer>
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
