@page "/"
@rendermode InteractiveServer
@inject IServicioService ServicioService
@inject ICatalogoService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Inicio | Lavadero</PageTitle>

<UltimaReserva />

<section class="hero mb-5"
         aria-labelledby="titulo-inicio">
    <div class="hero-copy">
        <span class="eyebrow">Reserva online</span>

        <h1 id="titulo-inicio">
            Tu auto limpio, sin perder tiempo esperando.
        </h1>

        <p>
            Elegí el servicio, seleccioná una fecha y reservá
            tu turno con los datos mínimos.
        </p>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary btn-lg"
               href="/reservar">
                Reservar turno
            </a>

            @*
                Antes era:
                <a href="#servicios">Ver servicios</a>

                Ese cambio de fragmento modificaba la URL y, con la
                navegación que venimos usando para conservar el tema,
                podía provocar que se re-renderizara la página y se
                perdiera visualmente el modo oscuro.

                Ahora NO hay navegación. El navegador solamente desplaza
                el contenedor actual hasta la sección Servicios.
            *@
            <button type="button"
                    class="btn btn-outline-secondary btn-lg"
                    onclick="document.getElementById('servicios')?.scrollIntoView({ behavior: 'smooth', block: 'start' });">
                Ver servicios
            </button>
        </div>
    </div>

    <aside class="hero-summary"
           aria-label="Cómo reservar">
        <span>1</span><p>Elegí un servicio</p>
        <span>2</span><p>Indicá tus datos y vehículo</p>
        <span>3</span><p>Seleccioná fecha y horario</p>
    </aside>
</section>

<section class="productos-destacados" aria-label="Productos destacados">
    <PageHeader Titulo="Productos destacados"
                Subtitulo="Los productos más elegidos por nuestros clientes." />

    @if (_cargandoProductos)
    {
        <LoadingSpinner Texto="Cargando productos destacados..." />
    }
    else if (_errorProductos is not null)
    {
        <AlertMessage Mensaje="@_errorProductos" Tipo="danger" />
    }
    else if (_productosDestacados.Count == 0)
    {
        <AlertMessage Mensaje="Todavía no hay productos disponibles." Tipo="info" />
    }
    else
    {
        <div class="row g-3">
            @foreach (var producto in _productosDestacados)
            {
                <div class="col-12 col-md-4" @key="producto.Id">
                    <ProductoCard Producto="producto"
                                  MostrarAgregar="false"
                                  TextoDetalle="Ver en el catálogo"
                                  OnVerDetalle="() => IrAlProducto(producto.Id)" />
                </div>
            }
        </div>
    }
</section>

<section id="servicios"
         style="scroll-margin-top: 90px;"
         aria-labelledby="titulo-servicios">

    <PageHeader Titulo="Servicios disponibles"
                Subtitulo="Estos servicios son administrados por el lavadero y se cargan desde la base de datos." />

    @if (_cargando)
    {
        <LoadingSpinner Texto="Cargando servicios..." />
    }
    else if (_error is not null)
    {
        <AlertMessage Mensaje="@_error"
                      Tipo="danger" />
    }
    else if (_servicios.Count == 0)
    {
        <AlertMessage Mensaje="No hay servicios disponibles en este momento."
                      Tipo="info" />
    }
    else
    {
        <div class="row g-3">
            @foreach (var servicio in _servicios)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <ServicioCard Servicio="servicio"
                                  OnReservar="IrAReservar" />
                </div>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<ServicioDto> _servicios =
        Array.Empty<ServicioDto>();

    private bool _cargando = true;
    private bool _cargandoProductos = true;
    private string? _error;
    private string? _errorProductos;
    private IReadOnlyList<ProductoDto> _productosDestacados = Array.Empty<ProductoDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _servicios =
                await ServicioService.ObtenerActivosAsync();
        }
        catch
        {
            _error =
                "No se pudieron cargar los servicios. " +
                "Intentá nuevamente más tarde.";
        }
        finally
        {
            _cargando = false;
        }

        try
        {
            _productosDestacados = await CatalogoService.ProductosDestacadosAsync(3);
        }
        catch
        {
            _errorProductos = "No se pudieron cargar los productos destacados.";
        }
        finally
        {
            _cargandoProductos = false;
        }
    }

    private void IrAReservar(int servicioId)
    {
        Navigation.NavigateTo(
            $"/reservar?servicio={servicioId}",
            forceLoad: true);
    }

    private void IrAlProducto(int productoId) =>
        Navigation.NavigateTo($"/productos?producto={productoId}", forceLoad: true);
}
